Header set Access-Control-Allow-Origin *

# Everything we serve is UTF-8, so say so in Content-Type.
# Without an explicit charset the browser decodes .js and .css using the
# *including page's* encoding, so any page that omits <meta charset="utf-8">
# falls back to windows-1252 and renders the UTF-8 text in library.js as
# mojibake -- e.g. the ellipsis in the "If There Is Time..." disclosure
# heading came through as three garbage characters. bjc.berkeley.edu already
# sends charset=utf-8; this makes bjc.edc.org match.
# AddDefaultCharset only covers text/html and text/plain, so .js/.css/.topic
# need AddCharset by extension.
AddDefaultCharset utf-8
AddCharset utf-8 .html .htm .js .css .topic .xml .json .svg

# This is a static site; nothing here should ever run as PHP. (There are old
# PHP crawler scripts in utilities/archive that must never execute.)
# Unhook any PHP handler/type a host may have mapped via AddHandler/AddType,
# then refuse such URLs outright. The 403 is the part that really matters:
# stock Debian/Ubuntu mod_php and most PHP-FPM setups attach PHP with a
# server-config <FilesMatch> SetHandler, which RemoveHandler can't undo.
# The pattern also catches path-info (foo.php/bar) and double extensions
# (foo.php.txt), both of which Apache will still hand to PHP.
# Only FileInfo-class directives are used, so this can't 500 the site on
# hosts that don't allow `php_flag` (Options) or `Require` (AuthConfig).
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar .phps
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar .phps
RedirectMatch 403 "(?i)\.ph(p[0-9]?|tml|t|ar|ps)(\.|/|$)"

AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/xml
AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE image/svg+xml
AddOutputFilterByType DEFLATE application/xhtml+xml
AddOutputFilterByType DEFLATE application/xml
AddOutputFilterByType DEFLATE application/rss+xml
AddOutputFilterByType DEFLATE application/atom_xml
AddOutputFilterByType DEFLATE application/x-javascript
AddOutputFilterByType DEFLATE application/x-httpd-php
AddOutputFilterByType DEFLATE application/x-httpd-fastphp
AddOutputFilterByType DEFLATE application/x-httpd-eruby

SetOutputFilter DEFLATE

SetEnvIfNoCase Request_URI \.(?:exe|t?gz|zip|bz2|sit|rar)$ no-gzip dont-vary
SetEnvIfNoCase Request_URI \.(?:pdf|avi|mov|mp3|mp4|rm)$ no-gzip dont-vary

BrowserMatch ^Mozilla/4 gzip-only-text/html
BrowserMatch ^Mozilla/4\.0[678] no-gzip
BrowserMatch \bMSIE !no-gzip !gzip-only-text/html

# Proxies should not deliver wrong content
Header append Vary User-Agent env=!dont-vary

#ExpiresActive On
#ExpiresDefault "access plus 10 weeks"
#ExpiresByType text/html "access plus 10 days"
#ExpiresByType text/css "access plus 10 days"
#ExpiresByType application/javascript "access plus 10 days"

<filesMatch "\.(html|htm|js|css|php|topic|xml)$">
FileETag None
Header unset ETag
Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
</filesMatch>

ErrorDocument 404 /bjc-r/404.html
